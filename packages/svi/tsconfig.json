{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "sourceMap": true,
  },
  "include": ["src/**/*", "bin"],
  "exclude": ["dist", "node_modules", "tests/**/*", "tests"],
  "extensions": [".ts", ".mts"]
}
