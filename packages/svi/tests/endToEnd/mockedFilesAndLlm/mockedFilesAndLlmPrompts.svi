# Destination File
# Input parameters
# Output
# Options
Active=True
ProgrammingLanguage=
# Import prompts
../endToEndPrompts.svi
# Prompt
LLM is mocked in a way that it returns the input prompts. Thus, the correctness of
input prompts can be tested.
Guidelines: 
* Don't use fakeFs.setCwd explicitly in test or in 'beforeEach' unless
requested in prompt (default folder will be set automatically in this case).
* Don't use checkProcessExitCalledWith(0) for code 0; in this case, process.exit(0)
is not called in the CLI explicitly.

A typical example
```ts
import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
import { runCli } from "../../../src/commands/entryPoint";
import { fakeFileSystem } from "../../testUtils/fakeFileSystem";
import {
  beforeEachSimpleTest,
  afterEachSimpleTest,
} from "../templates/simpleTest";
import FakeLogger from "../../testUtils/fakeLogger"; // If logging checks necessary
import {
  mockProcessExit,
  checkProcessExitCalledWith,
  restoreProcessExit,
} from "../../../testUtils/fakeProcess"; // If mocking process.exit() is necessary
// Levels of import may vary depending on location of a certain file

describe("Simple Test (E2E)", () => {
  let fakeFs: fakeFileSystem;
  let fakeLogger: FakeLogger; // If logging checks needed

  beforeEach(() => {
    fakeFs = new fakeFileSystem();
    fakeLogger = new FakeLogger(false);
    beforeEachSimpleTest(fakeFs, fakeLogger);
    mockProcessExit();
  });

  afterEach(() => {
    afterEachSimpleTest(fakeFs, fakeLogger);
    restoreProcessExit();
  });

  it("Generate one file", async () => {
    fakeFs.addFile(
      "svi.json",
      `
      {
        "programmingLanguage": "node.js",
        "searchPaths": [
          "*"`
        ],
        "ignorePaths": []
      }`
    );

    fakeFs.addFile(
      "test.svi",
      `
# Destination File
test.js
# Input parameters
# Output
# Options
Active=True
ProgrammingLanguage=node.js
# Import prompts
# Prompt
Test prompt
`
    );

    fakeFs.applyMocks();

    await runCli([
      "node",
      "svi",
      "run",
      "-m", // model name
      "gemini-2.5-flash",
      "-k", // api key
      "testKey",
    ]);

    expect(fakeFs.fileExists("test.js")).toBe(true);

    checkProcessExitCalledWith(1); // If necessary

    const content = fakeFs.fileContent("test.js");

    expect(content).toContain("Test prompt");

    // Logging checks example
    expect(
      fakeLogger.containsErrorLog(
        "Some error",
      ),
    ).toBe(true);
  });
});
```